{
  "name": "visagio-static-simulator",
  "version": "1.0.0",
  "type": "module",
  "description": "Visagio Static Simulator",
  "scripts": {
    "lint": "npm run lint:js -- --max-warnings=0",
    "lint:js": "eslint \"assets/js/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "format:check": "npm run format:js:check",
    "format:js:check": "prettier --check \"assets/js/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "format:js:write": "prettier --write \"assets/js/**/*.js\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "quality": "npm run lint && npm run format:check && npm test",
    "test": "python tests/run_all_tests.py",
    "test:public": "python tests/run_public_tests.py"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5"
  },
  "overrides": {
    "brace-expansion": "^1.1.18",
    "js-yaml": "^4.3.2"
  },
  "private": true
}
