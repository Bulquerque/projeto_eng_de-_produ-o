{
  "name": "visagio-static-simulator",
  "version": "1.0.0",
  "description": "Visagio Static Simulator",
  "scripts": {
    "lint": "npm run lint:js -- --max-warnings=0",
    "lint:js": "eslint \"assets/js/**/*.js\"",
    "format:check": "npm run format:js:check",
    "format:js:check": "prettier --check \"assets/js/**/*.js\"",
    "format:js:write": "prettier --write \"assets/js/**/*.js\"",
    "test": "python tests/run_all_tests.py"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5"
  },
  "private": true
}
